# Configurações de Ambiente — Task Today App

# Path base da API REST no Apache Karaf / fzlbpms (ou localhost em dev)
VITE_REST_API_BASE_URL=https://fzlbpms.local/api/tasktoday

# Keycloak (login + sincronização com o back-end). Sem estas variáveis, o app usa
# o login local de demonstração e os dados ficam só neste navegador.
VITE_KEYCLOAK_URL=https://fzlbpms.local/auth
VITE_KEYCLOAK_REALM=fzlbpms
VITE_KEYCLOAK_CLIENT_ID=fzl-tasktodayapp

# Google Analytics 4 (opcional)
VITE_GA4_MEASUREMENT_ID=
